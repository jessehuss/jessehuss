---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../content/site';
---

<BaseLayout
  title="About"
  description="About Jesse Huss — builder of ScriptureShelf, Wager, and Huss Consulting Group."
  path="/about"
>
  <div class="about-layout">
    <div class="about-photo">
      <img
        src={site.photo.src}
        alt={site.photo.alt}
        width="200"
        height="200"
        decoding="async"
      />
    </div>
    <div class="prose">
      <h1>About</h1>
      <p>{site.bio}</p>
      <p>{site.aboutExtended}</p>
      <p>
        <a href={site.social.github}>GitHub</a>
        ·
        <a href={site.social.linkedin}>LinkedIn</a>
        ·
        <a href="/contact">Contact</a>
      </p>
    </div>
  </div>
</BaseLayout>
