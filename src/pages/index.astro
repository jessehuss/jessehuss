---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site, projects } from '../content/site';
---

<BaseLayout title={site.name} description={site.tagline} path="/">
  <section class="hero" aria-labelledby="hero-heading">
    <div class="hero__copy reveal">
      <p class="hero__eyebrow">Builder · Lethbridge</p>
      <h1 id="hero-heading">{site.headline}</h1>
      <p>{site.tagline}</p>
      <div class="hero__actions">
        <a class="btn btn--primary" href="/work">See my work</a>
        <a class="btn btn--ghost" href="/contact">Get in touch</a>
      </div>
    </div>
    <div class="hero__photo reveal reveal-delay-1">
      <img
        src={site.photo.src}
        alt={site.photo.alt}
        width="300"
        height="300"
        decoding="async"
        fetchpriority="high"
      />
    </div>
  </section>

  <section class="section" aria-labelledby="work-heading">
    <div class="section__head">
      <h2 id="work-heading">Selected work</h2>
      <a href="/work">All projects</a>
    </div>
    <div class="card-grid">
      {projects.map((project, i) => <ProjectCard project={project} index={i} />)}
    </div>
  </section>

  <section class="section" aria-labelledby="about-heading">
    <div class="section__head">
      <h2 id="about-heading">About</h2>
      <a href="/about">More about me</a>
    </div>
    <p class="lead">{site.bio}</p>
  </section>

  <aside class="cta-band" aria-label="Contact">
    <p>
      <strong>Want to talk?</strong>
      Say hello about a project, ScriptureShelf, or consulting through Huss Consulting Group.
    </p>
    <a class="btn btn--primary" href="/contact">Contact</a>
  </aside>
</BaseLayout>
