---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../content/site';
---

<BaseLayout
  title="Work"
  description="Selected projects: ScriptureShelf, Huss Consulting Group, and Wager."
  path="/work"
>
  <div class="prose">
    <h1>Work</h1>
    <p>
      A short list of things I am building or running. No filler case studies —
      just honest status and links.
    </p>
  </div>

  <div class="project-list" style="margin-top: 1.5rem;">
    {
      projects.map((project) => (
        <article class="project">
          <header>
            <h2>{project.name}</h2>
            <span
              class={`badge ${project.status === 'in-progress' ? 'badge--progress' : ''}`}
            >
              {project.statusLabel}
            </span>
          </header>
          <p>{project.description}</p>
          {project.href && (
            <a href={project.href} rel="noopener noreferrer">
              Open {project.name}
            </a>
          )}
        </article>
      ))
    }
  </div>
</BaseLayout>
