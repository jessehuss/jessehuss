---
import type { Project } from '../content/site';
interface Props {
  project: Project;
}
const { project } = Astro.props;
---

<article class="card">
  <h3>{project.name}</h3>
  <p>{project.summary}</p>
  <div class="card__meta">
    <span class={`badge ${project.status === 'in-progress' ? 'badge--progress' : ''}`}>
      {project.statusLabel}
    </span>
    {
      project.href ? (
        <a class="card__link" href={project.href} rel="noopener noreferrer">
          Visit
          <span class="visually-hidden"> {project.name}</span>
        </a>
      ) : (
        <span class="card__link" style="color: var(--ink-faint);">Coming later</span>
      )
    }
  </div>
</article>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
